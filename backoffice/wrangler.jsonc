{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "kansha-back-office",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "AI_ENABLED": "true",
    "INGEST_UNIFIED": "false",
    "UI_DEFAULT": "v1",
    "COLLAB_UI_DEFAULT": "v1"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "kansha-back-office-staging",
      "vars": {
        "AI_ENABLED": "true",
        "INGEST_UNIFIED": "true",
        "UI_DEFAULT": "v2",
        "COLLAB_UI_DEFAULT": "v1"
      },
      "observability": {
        "enabled": true
      }
    }
  }
}
