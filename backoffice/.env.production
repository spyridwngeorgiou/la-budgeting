# Safe to commit: Supabase URL + anon/publishable key are meant to be public
# (protected by RLS, not secrets) and Next.js needs them present at BUILD
# TIME to inline into the client bundle -- the Cloudflare dashboard's
# "Runtime variables and secrets" only reach the deployed Worker at request
# time, not the `next build` step that already ran.
NEXT_PUBLIC_SUPABASE_URL=https://hjypszddhwohgvubirkc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_abPsNu86w8Iv6GWhY4VzMA_N--30rFs
