# Supabase project settings -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Set once the AI layer (phase 4) is wired up; leave blank until then.
ANTHROPIC_API_KEY=
AI_ENABLED=false
# Phase 7 cutover: "true" sends /documents/new, /aade and the email webhook
# through the unified ingest pipeline (inbox review). Off until cutover.
INGEST_UNIFIED=false
# Board assistant (collab space): per-user daily AI spend cap in cents
# (default 200 when unset; 0 disables it -- the org monthly budget still applies).
COLLAB_AI_DAILY_CENTS_PER_USER=
